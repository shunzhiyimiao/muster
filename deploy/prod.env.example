# 公网部署的配置。
#
#   cp deploy/prod.env.example deploy/.env
#   然后**把下面三处密钥全部换掉**——这个文件在仓库里,里面的值等于公开。
#
# 生成密钥:
#   openssl rand -base64 48 | tr -d '\n=+/' | head -c 48
#
# 这些值只该出现在服务器上的 deploy/.env 里。**不要提交**
# (仓库根的 .gitignore 已经挡了 deploy/.env)。

# 你买的域名。应用在 https://<它>,LiveKit 在 https://livekit.<它>
MUSTER_DOMAIN=muster.example.com

# 数据库口令。库不对外映射,但同一台机器上的其他容器仍够得着它
POSTGRES_PASSWORD=换掉我

# 签发登录令牌的密钥,**至少 32 字符**(服务端会校验,不够就拒绝启动)。
# 换掉它等于让所有已发出的令牌立即失效——这也是踢掉所有会话的办法
MUSTER_JWT_SECRET=换掉我换掉我换掉我换掉我换掉我换掉我换掉我换掉我

# LiveKit 的房间准入钥匙。密钥同样 ≥32 字符
LIVEKIT_API_KEY=musterkey
LIVEKIT_API_SECRET=换掉我换掉我换掉我换掉我换掉我换掉我换掉我换掉我

# 转写档位。实测见 deploy/dev-up.sh:small 是 CPU 上的甜点,
# medium 断崖式变慢(9 倍于实时,不能用)
WHISPER_MODEL=Systran/faster-whisper-small

# 转写能用几个核。**留至少一个给媒体面**——whisper 满载会把机器占满,
# 而 LiveKit 在同一台机器上转发音频包,CPU 一饱和声音就开始卡。
# 4 核机器填 3;核多可以调大。
WHISPER_CPUS=3

# 录制(LiveKit Egress)合成画面要跑一个 Chrome。给它的核数;0 不是关闭,要关就从 compose 里删掉 egress
EGRESS_CPUS=2

RUST_LOG=muster_server=info

# ---- 组织节点(compose 的 node 服务,会议 Agent 跑在它上面)----
# 节点不用口令:第一次启动生成密钥并入网,管理员 muster-admin node-approve <设备码> 批准,
# 再 badge-assign A-007 <节点id> && duty-set A-007。工牌账号本身仍要存在(kind=agent):
#   muster-admin account-add A-007 <任意口令> 小七 agent && grant A-007 member org
MUSTER_NODE_NAME=server-node
# 模型密钥:按服务端 provider 目录里的 api_key_env 给。落在服务器上的是节点的密钥,服务端不存
KIMI_API_KEY=
