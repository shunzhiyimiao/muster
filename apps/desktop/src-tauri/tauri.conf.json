{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "muster-desktop",
  "version": "0.1.0",
  "identifier": "com.muster.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:14173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Muster 点将台",
        "width": 1360,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png"] }
}
